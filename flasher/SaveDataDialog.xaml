<Window x:Class="TamaPoke.Flasher.SaveDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認儲存資料"
        Width="520" Height="310" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#08111F" Foreground="#F4F7FB"
        Icon="assets/TamaPoke.ico">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F7FB" />
      <Setter Property="Background" Value="#21324A" />
      <Setter Property="BorderBrush" Value="#3A4E69" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeadingText" Text="請選擇如何處理儲存資料" FontSize="21" FontWeight="Bold" />
    <StackPanel Grid.Row="1" Margin="0,18,0,18">
      <TextBlock x:Name="VersionText" Foreground="#BFD7EE" FontSize="14" />
      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                 Text="如選擇保留，安裝程式會先在電腦備份資料、重設裝置，並在安裝新韌體後還原資料。" />
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB2A8" FontSize="13"
                 Text="如選擇刪除，現有寶可夢、圖鑑、道具和設定都會消失。" />
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="備份並保留" Background="#23704E" BorderBrush="#45A979"
              Click="KeepButton_Click" />
      <Button Grid.Column="1" Content="刪除並重新安裝" Background="#873A3A" BorderBrush="#C36161"
              Click="DeleteButton_Click" />
      <Button Grid.Column="2" Content="取消" Click="CancelButton_Click" />
    </Grid>
  </Grid>
</Window>
